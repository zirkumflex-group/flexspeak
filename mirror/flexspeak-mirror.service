[Unit]
Description=Flexspeak update mirror sync (GitHub releases to updates.zirkumflex.io)
Documentation=file:///srv/flexspeak-updates/OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=flexspeak-mirror
Group=flexspeak-mirror
ExecStart=/usr/bin/python3 -I -B /srv/flexspeak-updates/sync.py
StateDirectory=flexspeak-mirror
StateDirectoryMode=0700
# The only writable place outside its state: the files Caddy serves.
ReadWritePaths=/srv/flexspeak-updates/public
UMask=0022
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
