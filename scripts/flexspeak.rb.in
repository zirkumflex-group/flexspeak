cask "flexspeak" do
  version "${VERSION}"
  sha256 "${ARM_SHA}"

  # The repository and its releases are public: no token is needed to download.
  url "https://github.com/zirkumflex-group/flexspeak/releases/download/${TAG}/Flexspeak-macos-arm64.dmg"
  name "Flexspeak"
  desc "Native TeamSpeak-compatible voice client"
  homepage "https://github.com/zirkumflex-group/flexspeak"

  depends_on arch: :arm64
  depends_on macos: :sonoma
  container type: :dmg

  app "Flexspeak.app"

  caveats "Requires macOS 14.2 or later. This build is ad-hoc signed, not notarized."
end
