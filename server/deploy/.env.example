# Copy this file to .env in the same folder and fill in every value.
# Lines starting with # are comments. Don't put spaces around "=".

# The name people's apps reach the server at, without https://. An A record for it must
# point at this machine. Passkeys are tied to this name: never change it once people use it.
DOMAIN=collection.example.com

# An address of yours. The certificate authority (Let's Encrypt) writes to it only if
# something is wrong with the HTTPS certificate.
ACME_EMAIL=admin@example.com

# The API key from Resend (resend.com) that sends the sign-in codes. It starts with "re_".
RESEND_API_KEY=re_replace_with_your_key

# The sender of the sign-in emails: a name and an address on the domain you verified with
# Resend. Keep the double quotes.
MAIL_FROM="Flexspeak <collection@example.com>"

# Optional. How much the server writes to its log: error, warn, info or debug.
# RUST_LOG=info

# Optional. Holds the server at one published build instead of following the newest.
# Leave it commented out normally. See DEPLOY.md, "Going back to an earlier version".
# MONSTER_IMAGE=ghcr.io/zirkumflex-group/flexspeak-monster:<commit sha>
